# Canonical site URL used for metadata, sitemap, and structured data.
NEXT_PUBLIC_SITE_URL=https://ashitanorobotics.co.jp

# --- Supabase (waitlist / booking storage) -------------------------------
# Project Settings > API. Server-only: never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
# service_role key bypasses RLS. Keep it on the server only.
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to hash client IPs for rate limiting (any long random string).
# e.g. `openssl rand -hex 32`
RATE_LIMIT_SECRET=

# --- Resend (confirmation / contact emails: https://resend.com) ----------
RESEND_API_KEY=
# Verified sender on your domain, e.g. あしたのロボティクス <noreply@ashitanorobotics.co.jp>
RESEND_FROM=
# Contact form recipient. Defaults to contact@ashitanorobotics.co.jp when unset
CONTACT_TO=contact@ashitanorobotics.co.jp
# Recipient of "new booking" notifications (booking id only). Defaults to CONTACT_TO
BOOKING_NOTIFY_TO=

# --- Launch switches (redeploy after changing) ---------------------------
# "true" opens /book and /api/book/* for invitation holders. Keep off until terms are final.
BOOKING_ENABLED=false
# "true" publishes /legal (特定商取引法に基づく表記) and links it in the footer.
LEGAL_NOTICE_PUBLISHED=false
