# Canonical site URL used for metadata, sitemap, and structured data.
NEXT_PUBLIC_SITE_URL=https://sundaylabs.co.jp

# --- Resend (contact emails: https://resend.com) -------------------------
RESEND_API_KEY=
# Verified sender on your domain, e.g. SundayLabs <noreply@sundaylabs.co.jp>
RESEND_FROM=
# Contact form recipient. Defaults to contact@sundaylabs.co.jp when unset
CONTACT_TO=contact@sundaylabs.co.jp

# --- Launch switches (redeploy after changing) ---------------------------
# "true" publishes /legal (特定商取引法に基づく表記) and links it in the footer.
LEGAL_NOTICE_PUBLISHED=false
